// Data

export async function fetchBoard(baseUrl, { timeoutMs = 10000 } = {}) {
  const res = await fetch(new URL('/api/departures', baseUrl), {
    headers: { 'User-Agent': `PennAhead-CLI/${VERSION}`, Accept: 'application/json' },
    signal: AbortSignal.timeout(timeoutMs),
  });
  let body = null;
  try {
    body = await res.json();
  } catch {
    // handled below
  }
  if (body?.source === 'coming_soon') {
    return { departures: [], alerts: [], isLive: false, fetchedAt: body.fetchedAt, notice: "PennAhead isn't open yet. Departures show here once it launches." };
  }
  if (!res.ok || !body) throw new Error(`HTTP ${res.status}`);
  return body;
}

// ---------------------------------------------------------------------------------------------
// Arguments

export function parseArgs(argv) {
  const opts = { filters: { lines: [], sec: false, ewr: false }, url: process.env.PENNAHEAD_URL || DEFAULT_URL, interval: MIN_INTERVAL_S };
  const take = (i, name) => {
    const v = argv[i + 1];
    if (v === undefined || v.startsWith('-')) throw new Error(`${name} needs a value`);
    return v;
  };
  for (let i = 0; i < argv.length; i++) {
    let a = argv[i];
    let inline;
    if (a.startsWith('--') && a.includes('=')) [a, inline] = [a.slice(0, a.indexOf('=')), a.slice(a.indexOf('=') + 1)];
    const value = (name) => (inline !== undefined ? inline : take(i++, name));
    switch (a) {
      case '-h':
      case '--help':
        opts.help = true;
        break;
      case '-V':
      case '--version':
        opts.version = true;
        break;
      case '-1':
      case '--once':
        opts.once = true;
        break;
      case '--json':
        opts.json = true;
        break;
      case '-a':
      case '--alerts':
        opts.showAlerts = true;
        break;
      case '--sec':
        opts.filters.sec = true;
        break;
      case '--ewr':
        opts.filters.ewr = true;
        break;
      case '--ascii':
        opts.ascii = true;
        break;
      case '--no-color':
        opts.color = false;
        break;
      case '--color':
        opts.color = true;
        break;
      case '-l':
      case '--line':
        for (const l of value('--line').split(',')) {
          const line = LINE_ALIASES[l.trim().toUpperCase()];
          if (!line) throw new Error(`Unknown line "${l}" (use NEC, NJCL, M&E, RARV or MOBO)`);
          if (!opts.filters.lines.includes(line)) opts.filters.lines.push(line);
        }
        break;
      case '--url':
        opts.url = value('--url');
        break;
      case '-i':
      case '--interval': {
        const n = Number(value('--interval'));
        if (!Number.isFinite(n)) throw new Error('--interval needs a number of seconds');
        opts.interval = Math.max(MIN_INTERVAL_S, Math.round(n));
        break;
      }
      default:
        if (/^#?\w?\d+$/.test(a)) opts.train = a.replace(/^#/, '');
        else throw new Error(`Unknown option "${a}" (see --help)`);
    }
  }
  return opts;
}

const USAGE = `PennAhead ${VERSION}: NJ TRANSIT track estimates at New York Penn Station, in the terminal.

Usage: pennahead [train] [options]

  pennahead              the departure board (full screen in a terminal; press ? for keys)
  pennahead 3861         train #3861's details
  pennahead -1 -l nec    print the NEC board once and exit

Options:
  -l, --line <lines>     NEC, NJCL, M&E (or ME), RARV, MOBO; comma-separated
      --sec, --ewr       only trains stopping at Secaucus / Newark Airport
  -a, --alerts           print the service alerts' full text (with --once)
  -1, --once             print once and exit (the default when output isn't a terminal)
      --json             print the API's data (filtered) as JSON
  -i, --interval <s>     refresh every <s> seconds (at least ${MIN_INTERVAL_S})
      --url <url>        another PennAhead server (default ${DEFAULT_URL}, or $PENNAHEAD_URL)
      --ascii            plain ASCII lines and meters
      --no-color         no colors (also NO_COLOR=1)
  -V, --version
  -h, --help

${DATA_LINE}
${INDEPENDENT_LINE}`;

// ---------------------------------------------------------------------------------------------
// Interactive view

function detectTheme(opts, stream) {
  const env = process.env;
  const color = opts.color ?? (env.NO_COLOR ? false : env.FORCE_COLOR ? true : Boolean(stream.isTTY));
  const truecolor =
    /truecolor|24bit/i.test(env.COLORTERM || '') || ['iTerm.app', 'WezTerm', 'vscode', 'ghostty'].includes(env.TERM_PROGRAM || '');
  const locale = env.LC_ALL || env.LC_CTYPE || env.LANG || '';
  const ascii = opts.ascii || (locale !== '' && !/utf-?8/i.test(locale)) || env.TERM === 'linux';
  return makeTheme({ color, truecolor, ascii });
}

// The terminal's full width (100 when it isn't a terminal, e.g. piped), 48 at the least
const termWidth = (stream) => Math.max(48, stream.columns || 100);

// Keys from raw stdin: one chunk can hold several keys
export function parseKeys(chunk) {
  const keys = [];
  const map = {
    '\x1b[A': 'up', '\x1bOA': 'up', '\x1b[B': 'down', '\x1bOB': 'down', '\x1b[C': 'right', '\x1bOC': 'right',
    '\x1b[D': 'left', '\x1bOD': 'left', '\x1b[5~': 'pageup', '\x1b[6~': 'pagedown', '\x1b[H': 'home', '\x1b[F': 'end',
    '\x1b[1~': 'home', '\x1b[4~': 'end', '\x1bOH': 'home', '\x1bOF': 'end',
  };
  let i = 0;
  while (i < chunk.length) {
    const rest = chunk.slice(i);
    const seq = Object.keys(map).find((s) => rest.startsWith(s));
    if (seq) {
      keys.push(map[seq]);
      i += seq.length;
      continue;
    }
    if (rest.startsWith('\x1b[')) {
      // Unknown CSI sequence: skip it
      const m = rest.match(/^\x1b\[[0-9;]*[~A-Za-z]/);
      i += m ? m[0].length : 2;
      continue;
    }
    const ch = chunk[i];
    i += 1;
    if (ch === '\x1b') keys.push('esc');
    else if (ch === '\r' || ch === '\n') keys.push('enter');
    else if (ch === '\x7f' || ch === '\b') keys.push('backspace');
    else if (ch === '\x03') keys.push('ctrl-c');
    else if (ch === '\x04') keys.push('ctrl-d');
    else if (ch === '\x15') keys.push('ctrl-u');
    else if (ch === '\x06') keys.push('ctrl-f');
    else if (ch === '\x02') keys.push('ctrl-b');
    else if (ch === '\t') keys.push('tab');
    else if (ch === '\x17') keys.push('ctrl-w');
    else if (ch >= ' ') keys.push(ch);
  }
  return keys;
}

async function runInteractive(opts) {
  const out = process.stdout;
  const stdin = process.stdin;
  const theme = detectTheme(opts, out);
  const state = {
    help: false,
    focus: 'list', // list | detail: where j/k go (and, on a narrow terminal, which pane shows)
    data: { departures: [], alerts: [], fetchedAt: null },
    loading: true,
    filters: opts.filters,
    showAlerts: Boolean(opts.showAlerts), // alert rows above the trains (a toggles)
    seenAlerts: loadSeenAlerts(), // alert IDs already shown: the count's red badge clears
    selectedKey: null,
    selectedIndex: 0,
    scroll: 0,
    detailScroll: 0,
    helpScroll: 0,
    prompt: null, // { kind: '/' | ':', text }
    lastSearch: null,
    flash: null, // { text, until }
    pending: null, // 'g' (gg) or 'w' (Ctrl-w h / l)
    nextFetchAt: 0,
    wantTrain: opts.train || null,
  };

  const restore = () => out.write('\x1b[?25h\x1b[?1049l');
  const quit = (code = 0) => {
    clearInterval(tick);
    restore();
    if (stdin.isTTY) stdin.setRawMode(false);
    process.exit(code);
  };
  process.on('SIGTERM', () => quit(0));
  process.on('uncaughtException', (err) => {
    restore();
    console.error(err);
    process.exit(1);
  });
  out.write('\x1b[?1049h\x1b[?25l');
  stdin.setRawMode(true);
  stdin.setEncoding('utf8');
  stdin.resume();

  // The list's items: service alerts, then trains. Selection follows the item's key across refreshes
  const items = () => listItems(state.data, state.filters, { showAlerts: state.showAlerts });
  const flash = (text) => (state.flash = { text, until: Date.now() + 2500 });
  const selectedItem = () => items()[state.selectedIndex];
  const firstTrainIndex = (list) => Math.max(0, list.findIndex((i) => i.kind === 'train'));

  function syncSelection() {
    const list = items();
    if (!list.length) {
      state.selectedIndex = 0;
      state.selectedKey = null;
      return list;
    }
    const byKey = state.selectedKey ? list.findIndex((i) => i.key === state.selectedKey) : -1;
    // Nothing selected yet: the first train (its details show on the right)
    state.selectedIndex = byKey >= 0 ? byKey : state.selectedKey ? Math.min(state.selectedIndex, list.length - 1) : firstTrainIndex(list);
    state.selectedKey = list[state.selectedIndex].key;
    return list;
  }

  function select(index) {
    const list = items();
    if (!list.length) return;
    const i = Math.max(0, Math.min(list.length - 1, index));
    if (list[i].key !== state.selectedKey) state.detailScroll = 0;
    state.selectedIndex = i;
    state.selectedKey = list[i].key;
  }

  // Select a train by number (from the command line or :3861), clearing filters that hide it
  function goToTrain(id) {
    const t = (state.data.departures || []).find((d) => String(d.train_id) === String(id));
    if (!t) return flash(`Train #${id} isn't on the board`);
    if (!items().some((i) => i.key === trainKey(t))) state.filters = { lines: [], sec: false, ewr: false };
    select(items().findIndex((i) => i.key === trainKey(t)));
    state.focus = 'detail';
  }

  async function refresh() {
    state.nextFetchAt = Date.now() + opts.interval * 1000;
    try {
      state.data = await fetchBoard(opts.url);
      state.loading = false;
      if (state.wantTrain) {
        goToTrain(state.wantTrain);
        state.wantTrain = null;
      }
    } catch (err) {
      state.loading = false;
      state.data = { ...state.data, error: err?.name === 'TimeoutError' ? 'timed out' : err?.message || String(err) };
    }
    draw();
  }

  // A box: top border, a blank line, body lines through a viewport (pinned header lines stay),
  // bottom border
  function box(width, height, top, body, scroll, bottom, color) {
    const viewH = Math.max(1, height - 3);
    const sticky = body.filter((l) => l.header);
    const scrollable = body.filter((l) => !l.header);
    const rows = Math.max(1, viewH - sticky.length);
    const maxScroll = Math.max(0, scrollable.length - rows);
    const s = Math.max(0, Math.min(scroll, maxScroll));
    const lines = [top, boxRow('', width, theme, color), ...[...sticky, ...scrollable.slice(s, s + rows)].map((l) => renderBodyLine(l, width, theme, color))];
    while (lines.length < viewH + 2) lines.push(boxRow('', width, theme, color));
    // Scroll position on the right border, like a scrollbar thumb
    if (maxScroll > 0 && !theme.ascii) {
      const thumb = 2 + sticky.length + Math.round((s / maxScroll) * (rows - 1));
      lines[thumb] = lines[thumb].replace(/│((?:\x1b\[0m)?)$/, `${theme.style('┃', { fg: '#D4D4D8' })}$1`);
    }
    lines.push(bottom);
    return { lines: lines.slice(0, height), scroll: s, maxScroll, rows };
  }

  function promptOrFlash(width, corners, fallbackLeft, fallbackRight, color) {
    const { style, g } = theme;
    if (state.prompt) {
      return borderLine(width, corners, [style(`${state.prompt.kind}${state.prompt.text}`, { bold: true }) + style(g.cursor, { dim: true })], [], theme, color);
    }
    if (state.flash && Date.now() < state.flash.until) {
      return borderLine(width, corners, [style(state.flash.text, { fg: AMBER, bold: true })], [], theme, color);
    }
    return borderLine(width, corners, fallbackLeft, fallbackRight, theme, color);
  }

  let layout = { list: { rows: 10, maxScroll: 0 }, detail: { rows: 10, maxScroll: 0 }, help: { rows: 10, maxScroll: 0 }, twoCol: false };

  // Alerts on screen count as seen; IDs no longer in the feed are dropped so the file stays small
  function markAlertsSeen(alerts) {
    const seen = state.seenAlerts;
    const current = new Set((state.data.alerts || []).map((a) => String(a.id)));
    let changed = false;
    for (const id of [...seen]) if (!state.loading && !current.has(id)) changed = seen.delete(id) || changed;
    for (const a of alerts) if (!seen.has(String(a.id))) changed = Boolean(seen.add(String(a.id)));
    if (changed) saveSeenAlerts(seen);
  }

  function listBox(width, height, color) {
    syncSelection();
    const data = state.loading ? { ...state.data, notice: 'Loading departures…' } : state.data;
    const { lines, alerts } = buildBoardBody(data, { filters: state.filters, showAlerts: state.showAlerts, selectable: true, selectedKey: state.selectedKey }, theme, width);
    if (state.showAlerts && !state.loading) markAlertsSeen(alerts);
    const countdown = Math.max(0, Math.ceil((state.nextFetchAt - Date.now()) / 1000));
    const b = boardBorders(data, { filters: state.filters, showAlerts: state.showAlerts, seen: state.seenAlerts, countdown, interactive: true, width }, theme, alerts);
    const top = borderLine(width, [theme.g.tl, theme.g.tr], b.top, [], theme, color);
    const bottom = promptOrFlash(width, [theme.g.bl, theme.g.br], b.bottomLeft, b.bottomRight, color);
    // Keep the selected row in view
    const scrollable = lines.filter((l) => !l.header);
    const selLine = scrollable.findIndex((l) => l.selected);
    const rows = Math.max(1, height - 3 - lines.filter((l) => l.header).length);
    if (state.selectedIndex === 0 || (selLine >= 0 && selLine < rows)) state.scroll = Math.min(state.scroll, Math.max(0, selLine));
    if (selLine >= 0 && selLine < rows && state.selectedIndex <= firstTrainIndex(items())) state.scroll = 0;
    else if (selLine >= 0) {
      if (selLine < state.scroll) state.scroll = selLine;
      if (selLine >= state.scroll + rows) state.scroll = selLine - rows + 1;
    }
    const f = box(width, height, top, lines, state.scroll, bottom, color);
    state.scroll = f.scroll;
    layout.list = f;
    return f.lines;
  }

  function detailBox(width, height, color, focused) {
    const item = selectedItem();
    const train = item?.kind === 'train' ? item.train : null;
    const { style } = theme;
    const hints = focused
      ? [style('j/k scroll', { dim: true }), style('J/K next', { dim: true }), style('h list', { dim: true })]
      : [style('l details', { dim: true })];
    const bottomFor = () =>
      layout.twoCol
        ? borderLine(width, [theme.g.bl, theme.g.br], hints, [], theme, color)
        : promptOrFlash(width, [theme.g.bl, theme.g.br], hints, [style('? help', { dim: true })], color);
    if (item?.kind === 'alert') {
      const { left, right } = alertTitles(item.alert, theme);
      const top = borderLine(width, [theme.g.tl, theme.g.tr], left, right, theme, color);
      const f = box(width, height, top, buildAlertBody(item.alert, theme, width), state.detailScroll, bottomFor(), color);
      state.detailScroll = f.scroll;
      layout.detail = f;
      return f.lines;
    }
    if (!train) {
      const top = borderLine(width, [theme.g.tl, theme.g.tr], [style('Details', { bold: true })], [], theme, color);
      const body = [{ text: style(state.loading ? 'Loading…' : 'No train selected', { dim: true }) }];
      const f = box(width, height, top, body, 0, borderLine(width, [theme.g.bl, theme.g.br], [], [], theme, color), color);
      layout.detail = f;
      return f.lines;
    }
    const { left, right } = trainTitles(train, theme);
    const top = borderLine(width, [theme.g.tl, theme.g.tr], left, right, theme, color);
    const f = box(width, height, top, buildTrainBody(train, theme, width), state.detailScroll, bottomFor(), color);
    state.detailScroll = f.scroll;
    layout.detail = f;
    return f.lines;
  }

  function draw() {
    const width = termWidth(out);
    const height = Math.max(8, out.rows || 24);
    const footer = footerLines(width, theme, DATA_LINE);
    const bodyH = Math.max(6, height - footer.length);
    let lines;

    if (state.help) {
      const top = borderLine(width, [theme.g.tl, theme.g.tr], [theme.style('Help', { bold: true }), theme.style('PennAhead', { dim: true })], [theme.style('q / Esc close', { dim: true })], theme);
      const f = box(width, bodyH, top, buildHelpBody(theme, width), state.helpScroll, borderLine(width, [theme.g.bl, theme.g.br], [], [], theme), BORDER);
      state.helpScroll = f.scroll;
      layout.help = f;
      lines = f.lines;
    } else {
      // Two columns when there's room: the list on the left, the selected train on the right
      layout.twoCol = width >= 120;
      if (layout.twoCol) {
        const rightW = Math.max(52, Math.min(96, Math.floor(width * 0.42)));
        const leftW = width - rightW;
        const listFocused = state.focus === 'list';
        const L = listBox(leftW, bodyH, listFocused ? BORDER_FOCUS : BORDER);
        const R = detailBox(rightW, bodyH, listFocused ? BORDER : BORDER_FOCUS, !listFocused);
        lines = L.map((l, i) => l + (R[i] ?? ''));
      } else {
        lines = state.focus === 'detail' && selectedItem() ? detailBox(width, bodyH, BORDER, true) : listBox(width, bodyH, BORDER);
      }
    }
    const screen = theme.fold([...lines, ...footer].slice(0, height).join('\n'));
    out.write('\x1b[H' + screen.split('\n').map((l) => `${l}\x1b[K`).join('\n') + '\x1b[J');
  }

  function search(query, direction = 1) {
    const list = items();
    const q = query.toLowerCase();
    if (!list.length || !q) return;
    const matches = (it) =>
      it.kind === 'train'
        ? String(it.train.train_id).includes(q) || cleanDestination(it.train.destination).toLowerCase().includes(q) || it.train.line.toLowerCase() === q
        : it.alert.text.toLowerCase().includes(q);
    for (let step = 1; step <= list.length; step++) {
      const i = (((state.selectedIndex + direction * step) % list.length) + list.length) % list.length;
      if (matches(list[i])) {
        select(i);
        return;
      }
    }
    flash(`No match: ${query}`);
  }

  function runCommand(cmd) {
    const c = cmd.trim().replace(/^#/, '');
    if (['q', 'q!', 'quit', 'qa', 'wq', 'x'].includes(c)) quit(0);
    if (/^\w?\d+$/.test(c)) return goToTrain(c);
    if (c === 'help' || c === 'h') {
      state.help = true;
      state.helpScroll = 0;
      return;
    }
    if (c) flash(`Not a command: ${c}`);
  }

  function toggleLine(line) {
    const l = state.filters.lines;
    state.filters.lines = l.includes(line) ? l.filter((x) => x !== line) : [...l, line];
  }

  const page = (pane) => Math.max(1, layout[pane].rows - 1);
  const half = (pane) => Math.max(1, Math.floor(layout[pane].rows / 2));
  const scrollPane = (key, pane, delta) => (state[key] = Math.max(0, Math.min(layout[pane].maxScroll ?? 0, state[key] + delta)));

  function handleKey(key) {
    if (key === 'ctrl-c') quit(0);

    if (state.prompt) {
      const p = state.prompt;
      if (key === 'esc') state.prompt = null;
      else if (key === 'enter') {
        state.prompt = null;
        if (p.kind === '/') {
          state.lastSearch = p.text;
          search(p.text, 1);
        } else runCommand(p.text);
      } else if (key === 'backspace') {
        if (p.text) p.text = p.text.slice(0, -1);
        else state.prompt = null;
      } else if (key.length === 1) p.text += key;
      return;
    }

    if (state.pending) {
      const pending = state.pending;
      state.pending = null;
      if (pending === 'g' && key === 'g') {
        if (state.help) state.helpScroll = 0;
        else if (state.focus === 'detail') state.detailScroll = 0;
        else select(0);
        return;
      }
      if (pending === 'w') {
        if (key === 'h' || key === 'left') state.focus = 'list';
        else if ((key === 'l' || key === 'right') && selectedItem()) state.focus = 'detail';
        else if (key === 'w' || key === 'ctrl-w') state.focus = state.focus === 'list' && selectedItem() ? 'detail' : 'list';
        return;
      }
    }

    if (state.help) {
      if (['q', 'esc', '?', 'h', 'left', 'enter'].includes(key)) state.help = false;
      else if (key === 'j' || key === 'down') scrollPane('helpScroll', 'help', 1);
      else if (key === 'k' || key === 'up') scrollPane('helpScroll', 'help', -1);
      else if (key === 'ctrl-d') scrollPane('helpScroll', 'help', half('help'));
      else if (key === 'ctrl-u') scrollPane('helpScroll', 'help', -half('help'));
      else if (key === 'ctrl-f' || key === 'pagedown') scrollPane('helpScroll', 'help', page('help'));
      else if (key === 'ctrl-b' || key === 'pageup') scrollPane('helpScroll', 'help', -page('help'));
      else if (key === 'G' || key === 'end') state.helpScroll = Number.MAX_SAFE_INTEGER;
      else if (key === 'g') state.pending = 'g';
      return;
    }

    // Keys for both panes
    switch (key) {
      case '?':
        state.help = true;
        state.helpScroll = 0;
        return;
      case '/':
      case ':':
        state.prompt = { kind: key, text: '' };
        return;
      case 'r':
        refresh();
        return;
      case 'a': {
        // Show the alerts above the trains and select the first; again: hide them, back to the trains
        state.showAlerts = !state.showAlerts;
        state.focus = 'list';
        const list = items();
        if (state.showAlerts) {
          if (list[0]?.kind === 'alert') select(0);
          else flash('No service alerts');
        } else if (!list.some((i) => i.key === state.selectedKey)) {
          state.selectedKey = null; // the first train
        }
        state.scroll = 0;
        return;
      }
      case '0':
        state.filters.lines = [];
        return;
      case '1':
      case '2':
      case '3':
      case '4':
      case '5':
        toggleLine(LINES[Number(key) - 1]);
        return;
      case 's':
        state.filters.sec = !state.filters.sec;
        return;
      case 'e':
        state.filters.ewr = !state.filters.ewr;
        return;
      case 'n':
      case 'N':
        if (state.lastSearch) search(state.lastSearch, key === 'n' ? 1 : -1);
        return;
      case 'J':
        select(state.selectedIndex + 1);
        return;
      case 'K':
        select(state.selectedIndex - 1);
        return;
      case 'g':
        state.pending = 'g';
        return;
      case 'ctrl-w':
        state.pending = 'w';
        return;
      case 'tab':
        state.focus = state.focus === 'list' && selectedItem() ? 'detail' : 'list';
        return;
    }

    if (state.focus === 'detail') {
      if (['q', 'esc', 'h', 'left', 'backspace'].includes(key)) state.focus = 'list';
      else if (key === 'j' || key === 'down') scrollPane('detailScroll', 'detail', 1);
      else if (key === 'k' || key === 'up') scrollPane('detailScroll', 'detail', -1);
      else if (key === 'ctrl-d') scrollPane('detailScroll', 'detail', half('detail'));
      else if (key === 'ctrl-u') scrollPane('detailScroll', 'detail', -half('detail'));
      else if (key === 'ctrl-f' || key === 'pagedown' || key === ' ') scrollPane('detailScroll', 'detail', page('detail'));
      else if (key === 'ctrl-b' || key === 'pageup') scrollPane('detailScroll', 'detail', -page('detail'));
      else if (key === 'G' || key === 'end') state.detailScroll = Number.MAX_SAFE_INTEGER;
      else if (key === 'home') state.detailScroll = 0;
      return;
    }

    // List
    if (key === 'q') quit(0);
    else if (key === 'j' || key === 'down') select(state.selectedIndex + 1);
    else if (key === 'k' || key === 'up') select(state.selectedIndex - 1);
    else if (key === 'ctrl-d') select(state.selectedIndex + half('list'));
    else if (key === 'ctrl-u') select(state.selectedIndex - half('list'));
    else if (key === 'ctrl-f' || key === 'pagedown' || key === ' ') select(state.selectedIndex + page('list'));
    else if (key === 'ctrl-b' || key === 'pageup') select(state.selectedIndex - page('list'));
    else if (key === 'G' || key === 'end') select(Number.MAX_SAFE_INTEGER);
    else if (key === 'home') select(0);
    else if ((key === 'enter' || key === 'l' || key === 'right') && selectedItem()) state.focus = 'detail';
  }

  stdin.on('data', (chunk) => {
    for (const key of parseKeys(chunk)) handleKey(key);
    draw();
  });
  out.on('resize', draw);
  // Once a second: the countdown, flash messages, and the refresh when it's due
  const tick = setInterval(() => {
    if (Date.now() >= state.nextFetchAt) refresh();
    else draw();
  }, 1000);

  draw();
  await refresh();
}

// ---------------------------------------------------------------------------------------------
// Main

async function main() {
  let opts;
  try {
    opts = parseArgs(process.argv.slice(2));
  } catch (err) {
    console.error(`pennahead: ${err.message}`);
    process.exit(2);
  }
  if (opts.help) return console.log(USAGE);
  if (opts.version) return console.log(VERSION);

  const interactive = !opts.once && !opts.json && process.stdout.isTTY && process.stdin.isTTY;
  if (interactive) return runInteractive(opts);

  let data;
  try {
    data = await fetchBoard(opts.url);
  } catch (err) {
    console.error(`pennahead: couldn't reach ${opts.url}: ${err?.name === 'TimeoutError' ? 'timed out' : err?.message || err}`);
    process.exit(1);
  }

  if (opts.json) {
    const departures = opts.train
      ? (data.departures || []).filter((d) => String(d.train_id) === opts.train)
      : filterDepartures(data.departures || [], opts.filters);
    const alerts = filterAlerts(data.alerts, opts.filters);
    return console.log(JSON.stringify({ ...data, departures, alerts, attribution: DATA_LINE }, null, 2));
  }

  const theme = detectTheme(opts, process.stdout);
  const width = termWidth(process.stdout);
  if (opts.train) {
    const train = (data.departures || []).find((d) => String(d.train_id) === opts.train);
    if (!train) {
      console.error(`pennahead: train #${opts.train} isn't on the board right now`);
      process.exit(1);
    }
    return console.log(renderTrain(train, theme, width));
  }
  console.log(renderBoard(data, { ...opts, seen: loadSeenAlerts() }, theme, width));
}

const isMain = (() => {
  try {
    return process.argv[1] && import.meta.url === pathToFileURL(realpathSync(process.argv[1])).href;
  } catch {
    return false;
  }
})();
if (isMain) main();
