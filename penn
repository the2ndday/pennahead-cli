// Seen alerts: kept in ~/.config/pennahead (or $XDG_CONFIG_HOME) like the site's browser storage,
// so the alert count isn't red again on every start. Best effort: without the file it's in memory.

export const seenAlertsFile = () => join(process.env.XDG_CONFIG_HOME || join(homedir(), '.config'), 'pennahead', 'seen-alerts.json');

export function loadSeenAlerts(file = seenAlertsFile()) {
  try {
    const ids = JSON.parse(readFileSync(file, 'utf8'));
    return new Set(Array.isArray(ids) ? ids.map(String) : []);
  } catch {
    return new Set();
  }
}

export function saveSeenAlerts(ids, file = seenAlertsFile()) {
  try {
    mkdirSync(dirname(file), { recursive: true });
    writeFileSync(file, JSON.stringify([...ids]));
  } catch {
    // read-only home or no permission: keep it in memory
  }
}

